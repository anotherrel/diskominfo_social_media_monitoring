# =====================================================================
# CONTOH KONFIGURASI - DKIS_MONITORING_FACEBOOK_TIKTOK
# Salin file ini menjadi .env lalu isi nilainya yang asli.
# JANGAN pernah menulis API key asli di file ini.
# =====================================================================

# 1. APIFY TOKEN (untuk pencarian post TikTok & Facebook)
APIFY_TOKEN=apify_api_isi_token_asli_disini

# 2. LLM-KITA GATEWAY (penilaian sentimen komentar + induksi aturan)
#    Boleh 1 key, boleh banyak dipisah koma (sistem rotasi otomatis kalau ada yang gagal).
LLMKITA_API_KEYS=isi_key_satu,isi_key_dua

# 3. Endpoint & model
#    Catatan hasil pengujian:
#      - nama model TIDAK boleh mengandung spasi (gateway membalas HTTP 400)
#      - alias "deepseek-v4-pro" RUSAK (balas kuota acak setelah ~60 detik)
#      - "gpt-5.6-terra" = model yang dipakai untuk menilai sentimen komentar
LLMKITA_BASE_URL=https://api.llm-kita.com/api/v1
LLMKITA_MODEL=gpt-5.6-terra
