# =====================================================================
# SETELAN BOT TELEGRAM — MONITORING SOSIAL MEDIA DKIS CIREBON
# Salin file ini menjadi bot/.env lalu isi nilainya yang asli.
# JANGAN pernah menulis token asli di file .example ini.
# =====================================================================

# ---------------------------------------------------------------------
# 1. TOKEN BOT (WAJIB)
#    Buat bot BARU di Telegram: chat @BotFather -> /newbot -> ikuti pertanyaannya.
#    PENTING: Satu token hanya boleh ditarik satu proses polling.
# ---------------------------------------------------------------------
BOT_TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_contoh

# ---------------------------------------------------------------------
# 2. SIAPA YANG BOLEH MEMAKAI (WAJIB)
#    Angka ini adalah Telegram user ID (bukan username). Cara tahu ID sendiri:
#    chat @userinfobot di Telegram, dia menjawab ID kamu.
#    Pisahkan dengan koma jika lebih dari satu. Contoh: 111111111,222222222
# ---------------------------------------------------------------------
BOT_ALLOWED_USER_IDS=111111111

# Admin: boleh memakai bot + menambah/menghapus user lain lewat bot.
BOT_ADMIN_USER_IDS=111111111

# ---------------------------------------------------------------------
# 3. PATH PYTHON UNTUK SCRAPER (WAJIB)
#    Jika dijalankan dari Windows: C:\Python312\python.exe atau python
#    Jika dijalankan dari WSL: /mnt/c/Python312/python.exe
# ---------------------------------------------------------------------
BOT_PYTHON_SCRAPER=python

# ---------------------------------------------------------------------
# 4. BATAS & TARIF ESTIMASI (opsional)
# ---------------------------------------------------------------------
BOT_TARIF_POST_PER_HASIL=0.0023
BOT_TARIF_KOMENTAR_PER_HASIL=0.0025
BOT_KURS_USD_IDR=16000
